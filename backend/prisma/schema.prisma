// TorneoApp — Entrega 3
// Modelo de datos: auth con roles + torneos propios de cada organizador

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  ORGANIZADOR
  JUGADOR
}

enum EstadoPartido {
  pendiente
  jugado
}

enum FormatoCompetencia {
  liga
  eliminatoria
}

enum RondaEliminatoria {
  octavos
  cuartos
  semifinal
  final
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(ORGANIZADOR)
  createdAt    DateTime @default(now())

  torneos Torneo[] @relation("TorneoOwner")

  @@map("users")
}

model Torneo {
  id           String             @id @default(cuid())
  ownerId      String
  owner        User               @relation("TorneoOwner", fields: [ownerId], references: [id])
  nombre       String
  deporte      String
  formato      FormatoCompetencia @default(liga)
  rondaInicial RondaEliminatoria?
  createdAt    DateTime           @default(now())

  equipos  Equipo[]
  partidos Partido[]

  @@map("torneos")
}

model Equipo {
  id       String @id @default(cuid())
  torneoId String
  torneo   Torneo @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  nombre   String

  jugadores              Jugador[]
  partidosLocal          Partido[] @relation("PartidoLocal")
  partidosVisita         Partido[] @relation("PartidoVisitante")
  partidosGanadosPenales Partido[] @relation("PartidoGanadorPenales")

  @@map("equipos")
}

model Jugador {
  id       String @id @default(cuid())
  equipoId String
  equipo   Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  nombre   String

  estadisticas EstadisticaJugador[]

  @@map("jugadores")
}

model Partido {
  id               String             @id @default(cuid())
  torneoId         String
  torneo           Torneo             @relation(fields: [torneoId], references: [id], onDelete: Cascade)
  jornada          Int
  orden            Int?
  ronda            RondaEliminatoria?
  localId          String
  local            Equipo             @relation("PartidoLocal", fields: [localId], references: [id])
  visitanteId      String
  visitante        Equipo             @relation("PartidoVisitante", fields: [visitanteId], references: [id])
  estado           EstadoPartido      @default(pendiente)
  golesLocal       Int?
  golesVisitante   Int?
  ganadorPenalesId String?
  ganadorPenales   Equipo?            @relation("PartidoGanadorPenales", fields: [ganadorPenalesId], references: [id])
  fecha            DateTime?

  estadisticas EstadisticaJugador[]

  @@map("partidos")
}

/// RF-11 (E3): estadísticas individuales de un jugador en un partido puntual.
model EstadisticaJugador {
  id          String  @id @default(cuid())
  partidoId   String
  partido     Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  jugadorId   String
  jugador     Jugador @relation(fields: [jugadorId], references: [id], onDelete: Cascade)
  goles       Int     @default(0)
  asistencias Int     @default(0)
  atajadas    Int     @default(0)

  @@unique([partidoId, jugadorId])
  @@map("estadisticas_jugador")
}
