# Postgres — en desarrollo podés levantar uno rápido con:
#   docker run --name torneoapp-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=torneoapp -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/torneoapp"

# Para producción: usar un Postgres gestionado gratuito (Neon, Supabase, Railway)
# y pegar acá su connection string.

JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
PORT=3000
